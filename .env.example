# Copia este archivo a .env y completa tus valores. NUNCA subas .env al repositorio.

# --- IA gratuita (cadena con respaldo). Orden de proveedores: gemini -> groq -> mock (solo reglas)
LLM_PROVIDERS=gemini,groq,mock
# Key gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Key gratis en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Base de datos: SQLite por defecto. Para PostgreSQL (ver compose.yaml):
# DATABASE_URL=postgresql+psycopg://pm:pm@localhost:5432/profile_manager

# --- Seguridad: genera uno con: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
